---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import DifficultyDots from '../../components/DifficultyDots.astro';
import { getProjects, type Project } from '../../data/projects';

interface Props {
  project: Project;
}

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — Projekty LEGO`}>
  <a class="back-link" href="/">← Wróć do listy projektów</a>
  <h1>{project.title}</h1>

  {project.thumbnail && (
    <img class="project-detail__image" src={project.thumbnail} alt={project.title} />
  )}

  {project.totalParts !== null && (
    <p class="project-detail__meta">Liczba elementów: {project.totalParts}</p>
  )}
  <p class="project-detail__meta">
    Poziom trudności: <DifficultyDots difficulty={project.difficulty} />
  </p>

  {project.model && (
    <section class="model-3d-link">
      <a class="download-button" href={`/projekty/${project.slug}/3d/`}>Zobacz model 3D</a>
    </section>
  )}

  <section class="instructions">
    <h2>Instrukcja</h2>
    {project.pdf ? (
      <>
        <a class="download-button" href={project.pdf} download>Pobierz instrukcję PDF</a>
        <div class="pdf-preview">
          <PdfViewer pdfUrl={project.pdf} />
        </div>
      </>
    ) : (
      <p>Instrukcja PDF nie jest jeszcze dostępna dla tego modelu.</p>
    )}
  </section>
</BaseLayout>
