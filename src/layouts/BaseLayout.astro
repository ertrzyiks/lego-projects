---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lista projektów LEGO zaprojektowanych w BrickLink Studio.' } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Projekty LEGO</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Modele zaprojektowane w BrickLink Studio.</p>
    </footer>
  </body>
</html>
